.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Engagement artifacts contain target data, findings, and evidence.
# These must never be committed.
engagements/
# hunt.sh's current-workspace pointer — contains the engagement name.
.easyhunt-run
scope.yaml
# Every per-engagement scope, not just the active one. These name real
# targets, contacts, and authorization references.
scope.*.yaml
!scope.example.yaml
# The loopback validation lab names no real target — it is 127.0.0.1/32 and a
# script in this repo. It has to ship, or nobody else can reproduce the runs
# that prove the exploit probes parse a finding.
!scope.lab.yaml
# The Juice Shop development target: loopback and the Docker bridge only, plus a
# container anyone can start. Names no real asset, and the next person needs it
# to exercise the exploit chain — no bug bounty program permits that freely.
!scope.juiceshop.yaml
config.yaml
.easyhunt-pins.json
*.jsonl
tests/_lab_root/

# Vetted third-party payload store.
# The upstream repo declares NO LICENSE, so its contents are all-rights-reserved
# and must not be redistributed with EasyHunt. The manifest and the vetting
# script are ours and DO ship — they let a new machine rebuild the store from
# the pinned commit with: python3 scripts/vet_payloads.py --fetch
payloads/*
!payloads/manifest.json

# Secrets — never committed.
.env
.env.*
*.pem
*.key
# The scope rules live once, above. A second copy of them here re-ignored
# `scope.*.yaml` *after* the `!scope.juiceshop.yaml` exception, and the last
# matching pattern wins — so the development target HANDOFF tells you to copy
# was never actually in the repo. A fresh clone followed the instructions and
# got "no such file".
# Session credentials, stored per engagement. `engagements/` already covers
# these; named explicitly so a workspace configured elsewhere is still caught.
sessions.json
