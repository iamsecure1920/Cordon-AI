    "(select\\s+.{0,80}?\\s+from\\s+|union\\s+(?:all\\s+)?select\\s+|insert\\s+into\\s+|order\\s+by\\s+|group\\s+by\\s+|having\\s+\\w)",
    "(mysql_query|mysqli_query|pg_query|sqlite_query|\\$wpdb->|executeQuery|createQuery|prepareStatement|createNativeQuery|rawQuery|execute\\()\\s*\\(?[^)]{0,120}(\\$|req|request|input|param|query|search|user|id|name)",
